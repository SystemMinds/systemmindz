# Express server port (default: 4000)
SERVER_PORT=4000

# ── Zepto Mail direct config (no superadmin backend needed) ──────────────────
ZEPTO_API_KEY=your-zepto-api-key-here
ZEPTO_FROM_EMAIL=noreply@systemmindz.com
ZEPTO_FROM_NAME=SystemMindz
ZEPTO_API_URL=https://api.zeptomail.in/v1.1/email

# Company inbox that receives contact form submissions
CONTACT_RECIPIENT_EMAIL=hello@systemmindz.com

# ── Optional: fetch config from superadmin backend instead ───────────────────
# AUTH_SERVICE_URL=
# INTERNAL_SERVICE_TOKEN=
